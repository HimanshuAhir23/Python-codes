class Solution(object):
    def isPalindrome(self, x):
        l=[]
        
        if x<0:
            return False
        while x>0:
            a=x%10
            x=x//10
            l.append(a)
        
        i=0
        j=len(l)-1

        while i<j:
            if l[i]!=l[j]:
                return False
            i=i+1
            j=j-1

        
        return True
       
        
